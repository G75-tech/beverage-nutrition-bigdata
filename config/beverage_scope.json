  "candidate_category_pattern": "\\b(drinks?|beverages?|water|juice|milk|coffee|tea|infusions?|cordials?)\\b",
  "group_patterns": [
    {
      "group": "Ready-to-drink coffee",
      "pattern": "\\b(coffee|espresso|cappuccino)\\b|\\b(?:cafe|caffe) latte\\b"
    },
    {
      "group": "Ready-to-drink tea",
      "pattern": "\\b(tea|matcha|chai)\\b"
    },
    {
      "group": "Plant-based milk",
      "pattern": "\\b(?:almond|soy|soya|oat|rice|cashew|hemp|coconut|pea|flax|plant)[ -]*(?:based[ -]*)?(?:milk|beverage|drink)\\b|\\bhorchata\\b"
    },
    {
      "group": "Sports and energy drinks",
      "pattern": "\\b(energy (?:juice )?(?:drink|beverage|shot)|sports? drink|electrolyte|isotonic)\\b"
    },
    {
      "group": "Dairy milk",
      "pattern": "\\bmilk\\b"
    },
    {
      "group": "Soft drinks",
      "pattern": "\\b(soda|soft drink|cola|root beer|ginger ale)\\b"
    },
    {
      "group": "Juice and fruit drinks",
      "pattern": "\\b(juice|juicedrink|nectar|fruit drink|lemonade|punch)\\b"
    },
    {
      "group": "Water",
      "pattern": "\\bwater\\b"
    }
  ],
  "preparation_rules": {
    "dry_pattern": "\\b(powder(?:ed)?|dry mix|whole beans?|ground coffee|coffee grounds|tea bags?|tea leaves|loose leaf|soluble coffee|instant coffee|k[ -]?cups?|pods?|sachets?)\\b",
    "dry_serving_pattern": "\\b(scoops?|packets?|envelopes?|sachets?|pods?|k[ -]?cups?|tea bags?)\\b",
    "excluded_product_pattern": "\\b(condensed|evaporated|creamers?|syrup|infant|toddler|baby formula|meal replacement|medical food|enteral|nutrition(?:al)? (?:shake|drink|beverage)|breakfast(?:\\s+\\w+){0,2}\\s+shakes?|alcoholic beverage|malt beverage|freezers?|freezer pops?|ice pops?|popsicles?|ice cream|frozen dessert)\\b|ready[ -]+to[ -]+drink meal|\\bprotein\\b.{0,30}\\b(liquids?|shakes?|drinks?|beverages?)\\b|\\b(shakes?|drinks?|beverages?)\\b.{0,20}\\bprotein\\b|\\b[0-9]+(?:\\.[0-9]+)?\\s*%\\s*abv\\b",
    "ambiguous_product_pattern": "\\b(mix|mixes|frozen|purees?|sauces?|soups?|puddings?|dressings?|gels?|jell(?:y|ies)|bars?|cand(?:y|ies)|snacks?|cookies?|yog[hu]rt|baby|children|childrens|nutrition(?:al)?|supplements?)\\b|\\bcoconut (?:milk|cream)\\b|\\bbuttermilk blends?\\b",
    "concentrate_exception_pattern": "\\b(?:not\\s+)?from\\s+(?:[a-z]+\\s+){0,6}concentrat(?:e|es|ed)\\b",
    "concentrate_pattern": "\\b(concentrat(?:e|es|ed)|dilute|dilution|add water|mix with water)\\b",
    "explicit_rtd_pattern": "\\bready[\\s-]+to[\\s-]+drink\\b",
    "liquid_description_pattern": "\\b(drinks?|beverages?|iced coffee|cold brew|chilled coffee|lattes?|cappuccino|tea|milk|juice|juicedrink|water|energy shot|electrolyte)\\b"
  },
  "serving_unit_aliases": {
    "g": "g",
    "grm": "g",
    "gm": "g",
    "ml": "ml",
    "mlt": "ml"
  }
}
